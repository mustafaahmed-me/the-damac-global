# Copy to .env and fill in values. Never commit the real .env file.

# --- Required -------------------------------------------------------------
# PostgreSQL connection used by Drizzle ORM (src/db/index.ts)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Port for `npm start` (defaults to 3000)
PORT=3000

# --- Public contact channels (rendered server-side; leave empty to hide) ---
# Company email shown in the footer and contact page. Also used for email fallbacks.
CONTACT_EMAIL=thedamacglobal@gmail.com
# WhatsApp number in international format, digits only, e.g. 923001234567
WHATSAPP_NUMBER=923714968118
# Instagram profile URL, e.g. https://www.instagram.com/your_handle
INSTAGRAM_URL=https://www.instagram.com/thedamacglobal
# Live LeadForge URL. Leave empty while LeadForge is in development (shows "Coming soon").
LEADFORGE_URL=
# Production domain, e.g. https://www.thedamacglobal.com
# Enables canonical URLs, Open Graph URLs and sitemap.xml.
SITE_URL=

# --- Google Sheets inquiry storage (server-side only) ----------------------
# Web app URL from Google Apps Script (google-apps-script/Code.gs), ends in /exec
SHEETS_WEBHOOK_URL=
# Must match SHARED_SECRET in the Apps Script Script Properties. Never expose to the browser.
SHEETS_SHARED_SECRET=


# --- Private admin portal (server-side only; never prefix with NEXT_PUBLIC_) ---
# Use a unique password with at least 16 characters.
ADMIN_PASSWORD=
# Generate a random secret of at least 32 characters (e.g. openssl rand -base64 48).
ADMIN_SESSION_SECRET=
